# Configuración para Electron / Windows Desktop
APP_ENV=production
APP_BASE_URL=http://127.0.0.1:8000
APP_PORT=8000

# Usar SQLite portátil con Electron + PHP
DB_CONNECTION=sqlite
# Para modo web/online, cambie a mysql y configure DB_HOST, DB_USERNAME, DB_PASSWORD y DB_NAME.
#DB_CONNECTION=mysql
#DB_HOST=127.0.0.1
#DB_USERNAME=root
#DB_PASSWORD=
#DB_NAME=db_partner
#DB_CHARSET=utf8mb4

# SQLite portable
SQLITE_PATH=database/database.db
# LOG_PATH=C:/Users/Usuario/AppData/Roaming/LaserTech Manager/logs/electron-php.log
