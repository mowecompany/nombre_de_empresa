!macro customInstall
  Delete "$DESKTOP\AUTOSERVICIO MI ESTRELLA 1.0.5.lnk"
  Delete "$DESKTOP\AUTOSERVICIO MI ESTRELLA 1.0.6.lnk"
  Delete "$DESKTOP\AUTOSERVICIO MI ESTRELLA 1.0.7.lnk"
  Delete "$DESKTOP\AUTOSERVICIO MI ESTRELLA 1.0.8.lnk"
  Delete "$DESKTOP\AUTOSERVICIO MI ESTRELLA 1.0.9.lnk"
  Delete "$DESKTOP\AUTOSERVICIO MI ESTRELLA 1.0.10.lnk"
  Delete "$DESKTOP\AUTOSERVICIO MI ESTRELLA.lnk"
  Delete "$DESKTOP\AUTOSERVICIO MI ESTRELLA - Acceso directo.lnk"
  RMDir /r "$APPDATA\autoservicio-la-estrella-desktop"
  RMDir /r "$APPDATA\AUTOSERVICIO MI ESTRELLA"
  CreateShortCut "$DESKTOP\AUTOSERVICIO MI ESTRELLA.lnk" "$INSTDIR\AUTOSERVICIO MI ESTRELLA.exe" "" "$INSTDIR\AUTOSERVICIO MI ESTRELLA.exe" 0
!macroend
